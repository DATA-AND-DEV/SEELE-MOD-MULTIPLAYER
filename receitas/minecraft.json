  "mundo": {
    "pasta": "world",
    "salvar": [
      { "console": "save-off" },
      { "console": "save-all flush", "esperar": "\\]: Saved the game", "prazo": 60 },
      { "copiar": "world" },
      { "console": "save-on" }
    ]
  },
  "saida": {
    "pronto": "\\]: Done \\(",
    "entrou": "\\]: ([A-Za-z0-9_]{1,16}) joined the game$",
    "saiu": "\\]: ([A-Za-z0-9_]{1,16}) left the game$",
    "parar": { "console": "stop", "esperar": "\\]: Stopping the server", "prazo": 60 }
